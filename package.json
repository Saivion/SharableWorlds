{
  "name": "sharableworlds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:seeds": "npx -y tsx scripts/test-seeds.ts",
    "test:scenes": "npx -y tsx scripts/test-scenes.ts",
    "test": "npm run test:seeds && npm run test:scenes",
    "cf:preview": "next build && wrangler dev",
    "cf:deploy": "next build && wrangler deploy",
    "cf:types": "wrangler types --include-runtime=false"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.128.0"
  }
}
